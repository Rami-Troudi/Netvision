# NetVision local non-Docker development defaults

# FastAPI backend is optional for the current dashboard scope.
# Required only for recommendation-related backend routes.
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_TIMEOUT_MS=3000

# Local Redis service for BullMQ queued jobs.
# Redis is optional for Overview, Peak Hours, QoS Analysis, admin map, and data quality.
# Redis is required only for queued jobs / simulation / recommendation export workflows.
REDIS_URL=redis://127.0.0.1:6381
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6381
REDIS_CONNECTION_TIMEOUT_MS=1000

# Local development only. Production should configure API_AUTH_TOKEN/API_TOKEN instead.
# AUTH_BYPASS=true
