  "api_routes": [
    {
      "route": "/api/data/[...slug]",
      "methods": [
        "GET"
      ],
      "file": "pages/api/data/[...slug].js",
      "purpose": "Serve allow-listed runtime JSON files and convert time_data Parquet slices into observations JSON.",
      "input": "URL slug for baseline.json, time_index.json, stats.json, or time_data/*.json|*.parquet.",
      "output": "JSON file stream or {timestamp, stats, observations, confidence?}.",
      "dependencies": [
        "runtime_data",
        "parquetjs-lite"
      ],
      "auth": "requireAuthenticatedRequest; dev bypass possible if no token configured.",
      "failure_modes": [
        "400 invalid path",
        "404 missing file",
        "500 parquet read failure"
      ]
    },
    {
      "route": "/api/simulate",
      "methods": [
        "POST"
      ],
      "file": "pages/api/simulate.js",
      "purpose": "Run direct Python simulation.",
      "input": "{cell_name, action, params?, time_entry?, mode?}.",
      "output": "simulation/simulator.py JSON result.",
      "dependencies": [
        "simulation/simulator.py",
        "runtime_data/time_index.json",
        "runtime_data/time_data"
      ],
      "auth": "Auth plus 10 requests/minute/IP.",
      "failure_modes": [
        "400 invalid action or time file",
        "503 whitelist unavailable",
        "500 Python spawn/simulation/JSON failure"
      ]
    },
    {
      "route": "/api/recommend",
      "methods": [
        "POST"
      ],
      "file": "pages/api/recommend.js",
      "purpose": "Proxy recommendation request to FastAPI /predict.",
      "input": "{cell_name, prb_load?, throughput?, active_users?, rrc_users?, cqi?, timestamp?}.",
      "output": "FastAPI recommendation payload.",
      "dependencies": [
        "FastAPI backend",
        "BACKEND_API_URL"
      ],
      "auth": "Auth plus 30 requests/minute/IP.",
      "failure_modes": [
        "400 missing cell_name",
        "502 backend unavailable",
        "backend status passthrough"
      ]
    },
    {
      "route": "/api/recommend-context",
      "methods": [
        "POST",
        "DELETE"
      ],
      "file": "pages/api/recommend-context.js",
      "purpose": "Upload/reset active imported recommendation context in FastAPI.",
      "input": "POST {baseline, slices, source?}; DELETE empty.",
      "output": "{success, context_source, cells?, observations?, busy_hour_profiles?, updated_at?}.",
      "dependencies": [
        "FastAPI backend"
      ],
      "auth": "Auth plus 10 requests/minute/IP.",
      "failure_modes": [
        "400 invalid payload",
        "502 backend unavailable or rejected context"
      ]
    },
    {
      "route": "/api/recommendations-export",
      "methods": [
        "GET"
      ],
      "file": "pages/api/recommendations-export.js",
      "purpose": "Proxy backend recommendation CSV export.",
      "input": "Optional timestamp query.",
      "output": "CSV text with backend content type/disposition.",
      "dependencies": [
        "FastAPI /recommendations/export"
      ],
      "auth": "Auth plus 30 requests/minute/IP.",
      "failure_modes": [
        "405 non-GET",
        "502 backend unreachable",
        "backend status passthrough"
      ]
    },
    {
      "route": "/api/drift",
      "methods": [
        "GET"
      ],
      "file": "pages/api/drift.js",
      "purpose": "Compute drift alerts from validation predictions.",
      "input": "abs_threshold?, pct_threshold?, limit?.",
      "output": "{generated_at, source, thresholds, total_cells, alert_cells, alerts}.",
      "dependencies": [
        "runtime_data/model_assets/val_predictions.parquet"
      ],
      "auth": "Auth plus 20 requests/minute/IP.",
      "failure_modes": [
        "500 when model asset is missing",
        "partial empty alerts on BigInt parquet decode issue"
      ]
    },
    {
      "route": "/api/peak-hours",
      "methods": [
        "GET"
      ],
      "file": "pages/api/peak-hours.js",
      "purpose": "Load or compute per-cell peak PRB hours.",
      "input": "refresh?, cell?, limit?.",
      "output": "{generated_at, source, total_cells, total_returned, rows}.",
      "dependencies": [
        "runtime_data/time_index.json",
        "runtime_data/time_data/*.parquet"
      ],
      "auth": "Auth plus 20 requests/minute/IP.",
      "failure_modes": [
        "500 missing/invalid runtime data",
        "writes peak_hours.json/csv as generated cache"
      ]
    },
    {
      "route": "/api/jobs",
      "methods": [
        "POST"
      ],
      "file": "pages/api/jobs/index.js",
      "purpose": "Create async simulation job.",
      "input": "{job_type?, cell_name, action, params?, time_entry?}.",
      "output": "202 {jobId, type, status}.",
      "dependencies": [
        ".runtime/jobs.sqlite",
        "Redis",
        "BullMQ"
      ],
      "auth": "Auth plus 20 requests/minute/IP.",
      "failure_modes": [
        "400 invalid payload",
        "500 SQLite create failure",
        "503 queue unavailable"
      ]
    },
    {
      "route": "/api/jobs/[id]",
      "methods": [
        "GET"
      ],
      "file": "pages/api/jobs/[id].js",
      "purpose": "Return async job status and result/error.",
      "input": "Job id path parameter.",
      "output": "{jobId,type,status,created_at,updated_at,result?} or {error}.",
      "dependencies": [
        ".runtime/jobs.sqlite",
        ".runtime/job-results"
      ],
      "auth": "Auth plus 120 requests/minute/IP.",
      "failure_modes": [
        "400 missing id",
        "404 job not found"
      ]
    }
  ],
