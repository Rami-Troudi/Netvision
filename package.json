{
  "name": "odc-viz",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "worker": "node job-workers/jobWorker.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:contracts": "node --test tests/contracts/*.mjs",
    "smoke:v2": "node scripts/v2-api-smoke.mjs",
    "smoke:v2:core": "node scripts/v2-api-smoke-core.mjs",
